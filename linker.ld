/* 指定内核的入口函数/符号为loader。引导程序（如 GRUB）跳转到内核时，会从loader对应的地址开始执行 */
ENTRY(loader)
/* 指定输出文件的格式为32位x86架构的ELF可执行文件 */
OUTPUT_FORMAT(elf32-i386)
/* 指定目标机器的体系结构为i386（Intel 80386 及兼容的 32位 CPU） */
OUTPUT_ARCH(i386:i386)

/* 定义 SECTIONS 块:链接器如何组合各个输入段，以及它们映射到内存中的布局 */
SECTIONS {
    /* 将当前位置计数器（Location Counter，用 '.' 表示）设置为 1MB (0x0100000 = 1048576 字节)。
       这意味着接下来的代码段将被加载到内存地址 1MB 处（避开 BIOS 和低端物理内存的占用） */
    . = 0x0100000;

    /* 定义最终内核文件中的代码段 (.text) */
    .text : {
        /* 优先将所有输入文件中的 .multiboot 段放在代码段的最前面。
           这是强制要求，因为 GRUB 必须在内核文件开头的前 8KB 内扫描到 Multiboot 魔数Header */
        *(.multiboot)
        /* 紧接着放入所有输入文件中的普通代码段（如各种函数的指令代码） */
        *(.text*)
        /* 接着放入所有只读数据段（如常量字符串、const 修饰的变量等） */
        *(.rodata)
    }

    /* 定义最终内核文件中的已初始化数据段 (.data) */
    .data : {
        /* 定义符号 start_ctors，记录全局构造函数列表在内存中的起始地址 */
        start_ctors = .;
        /* 强制保留（KEEP）所有输入文件中的 .init_array 段，防止链接器优化时误删。
           这里存放的是 C++ 全局对象/静态对象的构造函数指针 */
        KEEP(*(.init_array));
        /* 按初始化优先级（Priority）对 .init_array.* 进行排序并保留，确保按正确的顺序调用全局构造函数 */
        KEEP(*(SORT_BY_INIT_PRIORITY(.init_array.*)));
        /* 定义符号 end_ctors，记录全局构造函数列表在内存中的结束地址。
           C++ 运行时初始化代码可以通过遍历 [start_ctors, end_ctors) 依次调用构造函数 */
        end_ctors = .;
        /* 放入所有输入文件中的普通已初始化全局变量和静态变量 */
        *(.data)
    }

    /* 定义最终内核文件中的未初始化数据段 (.bss) */
    .bss : {
        /* 放入所有未初始化的全局/静态变量。
           注意：.bss 段在二进制镜像中不占用实际文件体积，但在内核装载到内存时会被清零 */
        *(.bss)
    }

    /* 定义 /DISCARD/ 抛弃段：告诉链接器不需要将这些段写入最终的内核文件中 */
    /DISCARD/ : {
        /* 抛弃所有全局析构函数数组（内核启动阶段通常不需要析构退出逻辑） */
        *(.fini_array*)
        /* 抛弃 GCC 编译器自动生成的版本和注释信息，以精简内核文件体积 */
        *(.comment)
    }

}

/*
 * 脚本作用
 * 1. 确定加载基址（1MB）： 把内核代码锚定在物理地址 0x100000（1MB），这是标准的 32 位 x86 内核加载起始位置，完美避开了低端物理内存中 BIOS IVT、BDA 和 VGA 显存等敏感区域。
 * 2. 保证 Multiboot 兼容： 将 *(.multiboot) 置于 .text 段的最顶端，确保生成的镜像能够被 GRUB 识别并成功引导。
 * 3. 支持 C++ 全局对象构造： 通过 start_ctors / end_ctors 标记 init_array 的区间，为内核中 C++ 全局对象的构造（Constructor Call）提供了必要的符号支持。
 *
 */